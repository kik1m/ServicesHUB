{
  "description": "This is the complete HUBly AI Data Dictionary. It explains ALL the tables and EVERY SINGLE FIELD in the database to ensure 100% accurate SQL generation.",
  "tables": {
    "profiles": {
      "description": "Stores user accounts, profile details, AI quotas, and preferences.",
      "fields": {
        "id": "UUID (Primary Key)",
        "full_name": "Text. User's display name.",
        "avatar_url": "Text. URL to profile picture.",
        "bio": "Text. Short biography.",
        "role": "Text. E.g., 'admin', 'user'.",
        "membership": "Text. Current membership level.",
        "updated_at": "Timestamp of last update.",
        "is_premium": "Boolean. True if user has premium plan.",
        "premium_since": "Timestamp. When they became premium.",
        "website": "Text. User's personal website URL.",
        "twitter": "Text. X/Twitter handle.",
        "github": "Text. GitHub handle.",
        "linkedin": "Text. LinkedIn URL.",
        "ai_search_count": "Integer. Total AI searches performed.",
        "last_ai_search_at": "Timestamp of their last AI search.",
        "followers_count": "Integer. Number of users following them.",
        "following_count": "Integer. Number of users they follow.",
        "email": "Text. User's email address.",
        "experience_level": "Text. Self-reported experience level.",
        "primary_goal": "Text. Their primary goal on HUBly.",
        "job_title": "Text. Self-reported job title.",
        "long_term_memory": "JSONB. Dynamic memory of what the AI learned about the user.",
        "ai_messages_today": "Integer. Daily quota tracking for AI chat.",
        "ai_last_reset_date": "Date. When the quota was last reset.",
        "workspace_context": "JSONB. Current workspace state/context."
      }
    },
    "tools": {
      "description": "Stores all AI tools published on the HUBly platform.",
      "fields": {
        "id": "UUID (Primary Key)",
        "name": "Text. Name of the tool.",
        "slug": "Text. URL-friendly unique identifier.",
        "short_description": "Text. Brief tagline.",
        "description": "Text. Full detailed description.",
        "features": "JSONB. Array or object of tool features.",
        "category_id": "UUID. Links to categories.id.",
        "pricing_type": "Text. (e.g., Free, Paid, Freemium).",
        "pricing_details": "Text. Short pricing summary.",
        "url": "Text. External URL to the tool.",
        "image_url": "Text. URL for the tool's cover image.",
        "is_approved": "Boolean. True if approved by admins.",
        "is_verified": "Boolean. True if verified tool owner.",
        "is_featured": "Boolean. True if currently featured.",
        "rating": "Numeric. Average user rating (1-5).",
        "reviews_count": "Integer. Total number of reviews.",
        "creator_id": "UUID. User who originally created the tool.",
        "created_at": "Timestamp. When it was added to HUBly.",
        "user_id": "UUID. The current owner/submitter.",
        "featured_until": "Timestamp. Expiration of featured status.",
        "icon_name": "Text. Name of UI icon.",
        "view_count": "BigInt. Number of times tool page was viewed.",
        "click_count": "BigInt. Number of external link clicks.",
        "updated_at": "Timestamp.",
        "pending_changes": "JSONB. Edits waiting for approval.",
        "use_cases": "Array of text. Use cases for the tool.",
        "pricing_details_full": "Text. Detailed pricing text.",
        "pricing_url": "Text. Direct link to pricing page."
      }
    },
    "reviews": {
      "description": "User reviews and ratings for tools.",
      "fields": {
        "id": "UUID (Primary Key)",
        "tool_id": "UUID. Links to tools.id.",
        "user_id": "UUID. Links to profiles.id.",
        "rating": "Integer (1-5). Rating given.",
        "comment": "Text. The review body.",
        "created_at": "Timestamp.",
        "parent_id": "UUID. If it's a reply to another review.",
        "is_owner_reply": "Boolean. True if the reply is from the tool owner."
      }
    },
    "categories": {
      "description": "Categories for AI tools.",
      "fields": {
        "id": "UUID (Primary Key)",
        "name": "Text. Category name.",
        "slug": "Text. URL slug.",
        "icon_name": "Text. UI icon name.",
