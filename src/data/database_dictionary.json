  "sql_tips": [
    "To find the most active users by tools published, JOIN profiles and tools on profiles.id = tools.user_id.",
    "For user views on a tool, check tools.view_count.",
    "Always use EXACT table and column names.",
    "Do not include semicolons at the end of your SQL queries."
